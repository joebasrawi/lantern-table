OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Shared across all campaigns; UTC day; 0 pauses AI requests.
LANTERN_AI_DAILY_LIMIT=100

# Optional portrait previews, with a separate daily image allowance.
LANTERN_PORTRAITS_ENABLED=false
LANTERN_SCENES_ENABLED=false
# Shared daily allowance for portrait and scene generation.
LANTERN_PORTRAIT_DAILY_LIMIT=10
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Opt-in browser turn notifications. Generate one persistent VAPID pair per deployment.
LANTERN_PUSH_ENABLED=false
LANTERN_VAPID_PUBLIC_KEY=
LANTERN_VAPID_PRIVATE_KEY=
LANTERN_VAPID_SUBJECT=
# Pause delivery without deleting browser opt-ins.
LANTERN_PUSH_PAUSED=false
