{
  "name": "lantern-table",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lantern-table",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTRAITS",
      "bucket_name": "lantern-table-portraits"
    }
  ],
  "vars": {
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "OPENAI_MODEL": "gpt-5.4-mini"
  }
}
